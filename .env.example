# ==========================================
# Narration & Locale Configuration
# ==========================================
CLAW_USER_LANGUAGE="auto"
CLAW_TTS="true"
CLAW_VOICE_NARRATOR="true"

# --- Тетяна (координатор) ---
CLAW_TTS_TETIANA="true"
CLAW_TTS_TETIANA_VOICE="tetiana"

# --- Атлас (виконавець) ---
CLAW_TTS_ATLAS="true"
CLAW_TTS_ATLAS_VOICE="atlas"

# --- Гріша (контроль) ---
CLAW_TTS_GRISHA="true"
CLAW_TTS_GRISHA_VOICE="grisha"

# Максимальна кількість символів для TTS-оголошення
CLAW_TTS_MAX_CHARS="150"

# ==========================================
# LLM Providers & Routing
# ==========================================
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"
GLM_API_KEY="your_glm_api_key_here"
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
GEMINI_API_KEY="your_gemini_api_key_here"
MISTRAL_API_KEY="your_mistral_api_key_here"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"

# ==========================================
# RAG Service Configuration
# ==========================================
RAG_BASE_URL="http://127.0.0.1:8787"
CLAW_RAG_EMBEDDING_BASE_URL="http://127.0.0.1:11434/v1"
CLAW_RAG_EMBEDDING_MODEL="nomic-embed-text"
CLAW_RAG_OPENAI_API_KEY="ollama"
CLAW_RAG_CHUNK_CHARS="2000"
CLAW_RAG_CHUNK_OVERLAP="400"
CLAW_READ_FILE_MAX_LINES="800"

# ==========================================
# Third-Party Integrations
# ==========================================
GITHUB_TOKEN="your_github_token_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_token_here"
ASC_KEY_ID="your_asc_key_id"
ASC_ISSUER_ID="your_asc_issuer_id"
ASC_PRIVATE_KEY_PATH="/path/to/AuthKey.p8"
XCODE_TEAM_ID="your_xcode_team_id"
RENDER_API_KEY="your_render_api_key"

# ==========================================
# System & Execution Parameters
# ==========================================
CLAW_AUTO_DECIDE="true"
CLAW_API_REQUEST_TIMEOUT="180"
CLAW_API_CONNECT_TIMEOUT="30"
CLAW_API_PAUSE_SECS="5"
CLAW_API_MAX_RETRIES="2"
CLAW_TPM_LIMIT=80000
CLAUDE_CODE_AUTO_COMPACT_INPUT_TOKENS=128000
SELECTED_MODEL="glm"

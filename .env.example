# ==========================================
# Narration & Locale Configuration
# ==========================================
CLAW_USER_LANGUAGE="auto"
CLAW_TTS="true"
CLAW_VOICE_NARRATOR="true"

# --- Тетяна (координатор) ---
CLAW_TTS_TETIANA="true"
CLAW_TTS_TETIANA_VOICE="tetiana"

# --- Атлас (виконавець) ---
CLAW_TTS_ATLAS="true"
CLAW_TTS_ATLAS_VOICE="atlas"

# --- Гріша (контроль) ---
CLAW_TTS_GRISHA="true"
CLAW_TTS_GRISHA_VOICE="grisha"

# Максимальна кількість символів для TTS-оголошення
CLAW_TTS_MAX_CHARS="150"

# ==========================================
# 3D Avatar Overlay Configuration (Green Mesh)
# ==========================================
# Вмикає/вимикає 3D аватар Atlas (зелена сітка на екрані)
CLAW_AVATAR_OVERLAY="true"
# Пристрій обчислень: mps (Apple Silicon GPU) або cpu
CLAW_AVATAR_DEVICE="mps"
# Розмір вікна оверлею в пікселях (750x750 = збільшений у ~3 рази)
CLAW_AVATAR_WIDTH="750"
CLAW_AVATAR_HEIGHT="750"
# Масштаб сітки аватара у вікні (1.0 = за замовчуванням)
CLAW_AVATAR_SCALE="1.0"
# Товщина ліній сітки (1.0 = тонка чітка сітка, 0.8 = надтонка)
CLAW_AVATAR_LINE_WIDTH="1.0"
# Частота кадрів рендерингу (30 FPS)
CLAW_AVATAR_FPS="30"

# ==========================================
# LLM Providers & Routing
# ==========================================
OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_BASE_URL="https://api.openai.com/v1"
GLM_API_KEY="your_glm_api_key_here"
GLM_BASE_URL="https://api.z.ai/api/paas/v4"
GEMINI_API_KEY="your_gemini_api_key_here"
MISTRAL_API_KEY="your_mistral_api_key_here"
MISTRAL_BASE_URL="https://api.mistral.ai/v1"

# ==========================================
# RAG Service Configuration
# ==========================================
RAG_BASE_URL="http://127.0.0.1:8787"
CLAW_RAG_EMBEDDING_BASE_URL="http://127.0.0.1:11434/v1"
CLAW_RAG_EMBEDDING_MODEL="nomic-embed-text"
CLAW_RAG_OPENAI_API_KEY="ollama"
CLAW_RAG_CHUNK_CHARS="2000"
CLAW_RAG_CHUNK_OVERLAP="400"
CLAW_READ_FILE_MAX_LINES="800"

# ==========================================
# Third-Party Integrations
# ==========================================
GITHUB_TOKEN="your_github_token_here"
CLOUDFLARE_API_TOKEN="your_cloudflare_token_here"
ASC_KEY_ID="your_asc_key_id"
ASC_ISSUER_ID="your_asc_issuer_id"
ASC_PRIVATE_KEY_PATH="/path/to/AuthKey.p8"
XCODE_TEAM_ID="your_xcode_team_id"
RENDER_API_KEY="your_render_api_key"

# ==========================================
# System & Execution Parameters
# ==========================================
CLAW_AUTO_DECIDE="true"
CLAW_API_REQUEST_TIMEOUT="180"
CLAW_API_CONNECT_TIMEOUT="30"
# Minimum spacing between API request *starts*, not a sleep added to every
# request: if the previous request plus the tool work after it already took
# longer than this, the next request goes out immediately.
CLAW_API_PAUSE_SECS="5"
CLAW_API_MAX_RETRIES="2"
# How long a request waits for the voice narrator to finish speaking before it
# ignores narration.lock and proceeds (0 disables the wait).
CLAW_TTS_WAIT_SECS="30"
# End the turn instead of burning iterations once the bifurcation ladder stays
# past its chaos point (r∞) for 3 steps. Off by default. See `claw fractal`.
CLAW_FRACTAL_HALT_AT_CHAOS="0"
# Tokens per minute the local rate limiter budgets for. Every request is charged
# a byte-derived estimate (see `api pacing` and `provider-reported token usage`
# in the log to compare the estimate against the provider's own count); a budget
# below ~3x the working-set size throttles the agent to a couple of requests a
# minute. A single request larger than the whole budget cannot be made smaller,
# so it is admitted at once and only logged (`request exceeds the entire TPM
# budget`) — set this to the provider's real limit or leave the limiter inert.
CLAW_TPM_LIMIT=80000
# Where log files are written. Defaults to ~/.claw/logs; `cargo test` and
# `cargo run` redirect to rust/target/claw-logs so test processes do not bury
# the live session's log.
# CLAW_LOG_DIR="~/.claw/logs"
CLAUDE_CODE_AUTO_COMPACT_INPUT_TOKENS=128000
SELECTED_MODEL="glm"
